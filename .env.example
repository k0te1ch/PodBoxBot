#! Этот файл необходимо переименовать в .env

# PODCAST SETTINGS
TIMEZONE = "Europe/Moscow"
PODCAST_NAME = "Разговорный жанр"
PODCAST_CITY = "Voronezh"
PODCAST_DISTRICT = "Voronezh region"
PODCAST_COUNTRY = "Russian Federation"
SUPPORT_LINK = "https://podbox.ru/donate/"
PODCAST_LINK = "https://podbox.ru/"


# TELEGRAM LOCAL SERVER SETTINGS
TELEGRAM_SERVER_API_ID = "123456789"
TELEGRAM_SERVER_API_HASH = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"


# TELEGRAM BOT SETTINGS
#! Токен бота, узнать можно у https://t.me/botfather
TELEGRAM_API_TOKEN = "1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
SKIP_UPDATES = "True"
#! Username публичной группы/канала для форварда анонсов (можно без @)
#! или числовой id чата, в котором бот состоит (для приватной группы)
FORWARD_CHAT_USERNAME = "@my_group"
#! Закреплять анонс молча (без уведомления подписчикам)
FORWARD_PIN_SILENT = "False"

# RSS подкаста: при новом эпизоде админам (ADMINS_ID) приходит «Выложить?».
# Работает только с Redis.
RSS_FEED_URL = "https://podbox.ru/feed/podcast/"
# RSS_FEED_URL = ""  # пустая строка выключает слежение
RSS_POLL_INTERVAL = "600"
RSS_FAILURE_ALERT = "6"

# Темы и вопросы от слушателей: один список для ведущих. Сообщение с
# «#тема» или «#вопрос» в чате попадает в список, ведущие смотрят его в личке
# бота (/topics или /admin → «Темы и вопросы») и удаляют обсуждённое: «удали
# 1, 3» или кнопками под списком. Чтобы бот видел обычные сообщения чата,
# сделай его админом группы (или выключи privacy mode: BotFather ->
# /setprivacy -> Disable). Работает только с Redis.
# В личке слушатель пишет /topic (/тема) или /question (/вопрос).
TOPICS_ENABLED = "false"
#! Где собирать темы и вопросы: @username или числовой id; пусто —
#! FORWARD_CHAT_USERNAME
TOPICS_CHAT = ""
#! Хештеги без «#», можно несколько через запятую; пустая строка выключает
#! сбор этого типа
TOPICS_HASHTAG = "тема"
TOPICS_QUESTION_HASHTAG = "вопрос"
#! Как бот отвечает на принятое сообщение с хештегом: реакцией и
#! эфемерным сообщением автору (его видит только он). Можно выключить любое.
TOPICS_ACK_REACTION = "true"
#! Эмодзи реакции. Только из списка реакций Telegram: 👍 🫡 👌 🔥 🎉 🤝 ✍ 💯
#! и другие, полный список: core.telegram.org/bots/api#reactiontypeemoji.
#! ✅ в этот список не входит; незнакомое эмодзи заменяется на 👍.
TOPICS_ACK_EMOJI = "👍"
TOPICS_ACK_EPHEMERAL = "true"
#! Пунктов от одного человека (или канала) за последние 24 часа (0: без
#! лимита) и длина текста. Список, лимит и бан-лист живут в модуле suggest из
#! SDK, но настраиваются здесь: SAGENZA_SUGGEST_* бот не читает. Админов
#! (ADMINS) ни лимит, ни бан, ни минимальная длина не касаются.
TOPICS_DAILY_LIMIT = "3"
TOPICS_MIN_LENGTH = "10"
TOPICS_MAX_LENGTH = "500"
#! Анкета «Предложить тему или вопрос» (/topic в чате или кнопка из /admin):
#! ephemeral — в группе, видна только автору; private — в личке бота; off
TOPICS_FORM_MODE = "ephemeral"
#! Чат ведущих (@username или числовой id), где админы тоже могут смотреть и
#! чистить список; пусто — только в личке бота
TOPICS_HOSTS_CHAT = ""


# FTP SETTINGS
FTP_SERVER = "test.io"
FTP_LOGIN = "user"
FTP_PASSWORD = "password"
#! Подпапка для послешоу: туда льёт FTP-публишер, оттуда бот читает
#! последний номер эпизода
FTP_POSTSHOW_DIR = "postshow"


# WORDPRESS
# Just to main page
WP_URL = "https://wordpress_site.org"
#! Адрес сайта для ссылки на редактор черновика, которую бот присылает после
#! публикации. Пусто: WP_URL. Нужен, если publisher ходит на сайт по
#! внутреннему адресу
WP_PUBLIC_URL = ""
WP_LOGIN = "user"
WP_PASSWORD = "password"
WP_APP_PASSWORD = "app_password"


# BOOSTY
# Кнопка Boosty в меню послешоу. Включать после смоука
# (app/publishers/Boosty/SMOKE.md), пока токены не готовы — false.
BOOSTY_ENABLED = "false"
# Slug блога: boosty.to/<BOOSTY_BLOG>
BOOSTY_BLOG = "my_blog"
# auth.json собирается из кук браузера командой `python smoke.py import-cookie`
# (access_token / refresh_token / device_id), дальше сервис сам обновляет токен.
# Путь ВНУТРИ контейнера; на хосте файл кладётся в
# ./secrets/boosty/boosty_auth.json (bind-mount → /app/data).
BOOSTY_AUTH_FILE = "/app/data/boosty_auth.json"
# Числовой id владельца блога (= container_id для загрузки аудио). Виден как
# ownerId / X-From-Id в трафике редактора. Без него upload берёт id из активного
# черновика — но на «пустом» блоге черновика нет, так что лучше задать явно.
BOOSTY_OWNER_ID = "1900545"
# Числовой id платного уровня подписки, к которому привязывается пост.
BOOSTY_SUBSCRIPTION_LEVEL_ID = "407063"
# Цена поста (pay-per-post), в рублях.
BOOSTY_PRICE = "10"
# Обложка-тизер (лежит на томе static). Опционально — есть дефолт.
# BOOSTY_COVER_PATH = "/app/static/boosty_pscover.png"
# Что делать с постом: publish — сразу подписчикам (по умолчанию);
# draft — черновиком в редактор блога, публикует автор; scheduled — отложенным
# постом через BOOSTY_SCHEDULE_DELAY_HOURS часов.
# BOOSTY_PUBLISH_MODE = "publish"
# BOOSTY_SCHEDULE_DELAY_HOURS = "24"


# VK DONUT (app/publishers/VK/SMOKE.md). Сервис поднимается профилем paywalled.
VK_ENABLED = "false"
# Пользовательский токен админа сообщества с правами wall,video,docs,offline
VK_ACCESS_TOKEN = ""
# id сообщества без минуса
VK_GROUP_ID = ""
# -1 — пост навсегда только для донов, N — откроется всем через N дней
# VK_DONUT_PAID_DURATION = "-1"
# Как прикрепить mp3: video (mp4 с обложкой) | doc | none
# VK_MEDIA = "video"


# PATREON (app/publishers/Patreon/SMOKE.md). API v2 постов не создаёт —
# publisher работает как веб-редактор по куке session_id.
PATREON_ENABLED = "false"
# Файл сессии пишет `python smoke.py import-cookie`; на хосте — secrets/patreon/
# PATREON_SESSION_FILE = "/app/data/patreon_session.json"
# JSON-список id уровней; пусто — пост для всех платных патронов
PATREON_TIER_IDS = "[]"


# SPONSR (app/publishers/Sponsr/SMOKE.md). API нет; запросы публикации
# снимаются из HAR редактора, до этого publisher отвечает понятной ошибкой.
SPONSR_ENABLED = "false"
# slug проекта: sponsr.ru/<SPONSR_PROJECT>
SPONSR_PROJECT = ""
# SPONSR_SESSION_FILE = "/app/data/sponsr_session.json"


# LOGGER SETTINGS
# "TRACE", "DEBUG", "INFO", "SUCCESS", "WARNING", "ERROR", "CRITICAL"
LOG_LEVEL = "INFO"


# default tg_server is official api server
# it can be for example:
#TG_SERVER = 'http://api:8081'
LOCAL = "False"


# default parse_mode is None
# it can be "html" or "markdown"
PARSE_MODE = "html"


# example: socks5://127.0.0.1:1080
# PROXY

# example:
# from aiohttp import BasicAuth
# PROXY_AUTH = BasicAuth(
#     USERNAME,
#     PASSWORD
# )
# PROXY_AUTH

# if True, then bot will support work with DATABASE
DATABASE = "False"


# example:
# MYSQL = mysql+pymysql://USER:PASS@HOST:PORT/DB?charset=utf8mb4
# SQLITE = sqlite:///database.sqlite
DATABASE_URL = "sqlite:///database.sqlite"


# Пароль для встроенного redis (docker-compose). Обязательно задай —
# bot/redis/redis_exporter все берут его из этой переменной.
REDIS_PASSWORD = "change_me"

# REDIS_URL ВРУЧНУЮ выставлять не надо: в docker-compose он собирается
# автоматом из REDIS_PASSWORD как redis://:${REDIS_PASSWORD}@redis:6379/0.
# Раскомментируй только если запускаешь бота не в docker'е и redis
# где-то снаружи. Если REDIS_URL не задан — bot и APScheduler используют
# memory storage (FSM не переживает рестарт).
# REDIS_URL = "redis://:password@host:6379/0"


HANDLERS_DIR = "handlers"
MODELS_DIR = "models"


# if REDIS_URL is set, APSCHEDULER uses redis to store jobs
ENABLE_APSCHEDULER = "False"


ADMINS = ["admin"]
ADMINS_ID = [0]

HANDLERS = ["middlewares", "start", "admin_panel"]

LANGUAGES = ["ru", "en"]

# Группы заметок ведущих (/note #тема текст).
NOTE_TAGS = ["тема", "вопрос", "комментарий"]

# FILES
COVER_RZ_NAME = "cover.jpg"
COVER_PS_NAME = "pscover.jpg"
PODCAST = "podcast.mp3"
FILES_PATH = "files"
LOGS_PATH = "logs"

# KAFKA SETTINGS
KAFKA_SERVER = "kafka:9092"
SCHEMA_REGISTRY_URL = "http://schema-registry:8081"
# Предупреждение админам о заполнении диска
DISK_ALERT_PERCENT=85
DISK_CHECK_INTERVAL=3600

# sagenza-tgbot-sdk: чат для notify (по умолчанию первый админ), порт health-сервера
# SAGENZA_NOTIFY_CHAT_ID=
# SAGENZA_HEALTH_PORT=8080
# Апдейт дольше стольких секунд пишется в лог как WARNING (по умолчанию 2)
# SAGENZA_LOG_SLOW_UPDATE_SECONDS=2

# Копия метрик бота и публишеров во вторую Prometheus (сервис metrics-forwarder).
# Сервис запущен всегда; пока адрес пустой, он ничего не шлёт и не шумит в логах.
# Адрес приёмника: Prometheus с --web.enable-remote-write-receiver.
# После правки: docker compose up -d metrics-forwarder
PERSONAL_METRICS_REMOTE_WRITE_URL=
# Метка source у всех пересланных рядов (по умолчанию podboxbot)
# PERSONAL_METRICS_SOURCE=podboxbot

# Чат (id) для алертов Grafana; бот шлёт их токеном TELEGRAM_API_TOKEN.
# Обычно id админа из ADMINS_ID. 0 — алерты видны только в Grafana.
GRAFANA_ALERT_CHAT_ID=
